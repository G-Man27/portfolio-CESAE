<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/text_resultado"
        android:layout_width="332dp"
        android:layout_height="50dp"
        android:layout_marginTop="201dp"
        android:layout_marginBottom="70dp"
        android:textAlignment="center"
        android:textColor="#FF0707"
        android:textSize="34sp"
        app:layout_constraintBottom_toTopOf="@+id/button_ola"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_ola"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="76dp"
        android:layout_marginBottom="72dp"
        android:text="Dizer Olá"
        app:layout_constraintBottom_toTopOf="@+id/edit_nome"
        app:layout_constraintStart_toStartOf="@+id/edit_nome"
        app:layout_constraintTop_toBottomOf="@+id/text_resultado" />

    <EditText
        android:id="@+id/edit_nome"
        android:layout_width="260dp"
        android:layout_height="74dp"
        android:layout_marginBottom="210dp"
        android:autofillHints=""
        android:ems="10"
        android:hint="Insira o seu nome"
        android:inputType="text|textAutoComplete"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_ola" />

</androidx.constraintlayout.widget.ConstraintLayout>